      "durationMinutes": 7,
      "difficulty": "Growing",
      "interaction": "choice",
      "rounds": [
        {
          "prompt": "Which word rhymes with 'star'?",
          "visual": "⭐",
          "choices": [{ "id": "car", "label": "Car" }, { "id": "tree", "label": "Tree" }, { "id": "fish", "label": "Fish" }],
          "answer": "car",
          "hint": "Listen for the ending sound."
        },
        {
          "prompt": "Which word means the opposite of 'quiet'?",
          "visual": "🤫",
          "choices": [{ "id": "loud", "label": "Loud" }, { "id": "soft", "label": "Soft" }, { "id": "slow", "label": "Slow" }],
          "answer": "loud",
          "hint": "Think about a noisy playground."
        },
        {
          "prompt": "Which word completes this sentence? The sun is ___.",
          "visual": "☀️",
          "choices": [{ "id": "bright", "label": "bright" }, { "id": "sleepy", "label": "sleepy" }, { "id": "cold", "label": "cold" }],
          "answer": "bright",
          "hint": "What does sunlight help you see?"
        },
        {
          "prompt": "Which word starts with the same sound as 'moon'?",
          "visual": "🌙",
          "choices": [{ "id": "mouse", "label": "Mouse" }, { "id": "sun", "label": "Sun" }, { "id": "rain", "label": "Rain" }],
          "answer": "mouse",
          "hint": "Say both words slowly."
        }
      ]
    },
    {
      "id": "fraction-forge",
      "title": "Fraction Forge",
      "ageBand": "10-15",
      "minAge": 10,
      "maxAge": 15,
      "category": "Maths",
      "icon": "🧩",
      "accent": "ocean",
      "description": "Shape fractions into equivalent values and solve quick-fire challenges.",
      "skills": ["Fractions", "Problem solving"],
      "durationMinutes": 8,
      "difficulty": "Challenge",
      "interaction": "choice",
      "rounds": [
        {
          "prompt": "Which fraction is equivalent to 1/2?",
          "visual": "1/2 = ?",
          "choices": [{ "id": "2/4", "label": "2/4" }, { "id": "2/3", "label": "2/3" }, { "id": "3/5", "label": "3/5" }],
          "answer": "2/4",
          "hint": "Multiply the numerator and denominator by the same number."
        },
        {
          "prompt": "What is 3/4 + 1/4?",
          "visual": "🍕  3/4 + 1/4",
          "choices": [{ "id": "1", "label": "1" }, { "id": "3/8", "label": "3/8" }, { "id": "4/8", "label": "4/8" }],
          "answer": "1",
          "hint": "The denominators already match."
        },
        {
          "prompt": "Which is the greatest value?",
          "visual": "2/3   3/5   1/2",
          "choices": [{ "id": "2/3", "label": "2/3" }, { "id": "3/5", "label": "3/5" }, { "id": "1/2", "label": "1/2" }],
          "answer": "2/3",
          "hint": "Compare them using a common denominator or decimals."
        },
        {
          "prompt": "What is 5/6 - 1/3?",
          "visual": "5/6 - 1/3 = ?",
          "choices": [{ "id": "1/2", "label": "1/2" }, { "id": "2/3", "label": "2/3" }, { "id": "4/6", "label": "4/6" }],
          "answer": "1/2",
          "hint": "Rewrite 1/3 as 2/6 first."
        }
      ]
    },
    {
      "id": "logic-lab",
      "title": "Logic Lab",
      "ageBand": "10-15",
      "minAge": 10,
      "maxAge": 15,
      "category": "Logic",
      "icon": "🧠",
      "accent": "violet",
