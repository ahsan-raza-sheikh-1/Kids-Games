          "answer": "photosynthesis",
          "hint": "The word starts with photo, meaning light."
        },
        {
          "prompt": "Which material is a good electrical conductor?",
          "visual": "🔋 ─── ?",
          "choices": [{ "id": "copper", "label": "Copper" }, { "id": "rubber", "label": "Rubber" }, { "id": "glass", "label": "Glass" }],
          "answer": "copper",
          "hint": "Many wires use this shiny metal."
        }
      ]
