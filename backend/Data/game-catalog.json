      "difficulty": "Challenge",
      "interaction": "pattern",
      "rounds": [
        {
          "prompt": "Which number completes the sequence?",
          "visual": "2, 4, 8, 16, ❓",
          "choices": [{ "id": "24", "label": "24" }, { "id": "32", "label": "32" }, { "id": "34", "label": "34" }],
          "answer": "32",
          "hint": "Each number is doubled."
        },
        {
          "prompt": "If all zips are fast and Kai is a zip, what is true?",
          "visual": "All zips → fast\nKai → zip",
          "choices": [{ "id": "fast", "label": "Kai is fast" }, { "id": "slow", "label": "Kai is slow" }, { "id": "unknown", "label": "We cannot know" }],
          "answer": "fast",
          "hint": "Follow the two facts in order."
        },
        {
          "prompt": "What is the next letter?",
          "visual": "A, C, E, G, ❓",
          "choices": [{ "id": "H", "label": "H" }, { "id": "I", "label": "I" }, { "id": "J", "label": "J" }],
          "answer": "I",
          "hint": "Count two letters forward each time."
        },
        {
          "prompt": "A cube has 6 faces. How many faces do two cubes have altogether?",
          "visual": "🧊 + 🧊",
          "choices": [{ "id": "6", "label": "6" }, { "id": "12", "label": "12" }, { "id": "18", "label": "18" }],
          "answer": "12",
          "hint": "Add the faces on both cubes."
        }
      ]
    },
