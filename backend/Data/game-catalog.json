    {
      "id": "counting-garden",
      "title": "Counting Garden",
      "ageBand": "5-10",
      "minAge": 5,
      "maxAge": 10,
      "category": "Numbers",
      "icon": "🌼",
      "accent": "sun",
      "description": "Help friendly garden visitors count, compare, and grow their number sense.",
      "skills": ["Number sense", "Focus"],
      "durationMinutes": 5,
      "difficulty": "Starter",
      "interaction": "choice",
      "rounds": [
        {
          "prompt": "How many flowers are blooming?",
          "visual": "🌼 🌼 🌼",
          "choices": [{ "id": "2", "label": "2" }, { "id": "3", "label": "3" }, { "id": "4", "label": "4" }],
          "answer": "3",
          "hint": "Touch-count each flower once."
        },
        {
          "prompt": "How many butterflies are visiting?",
          "visual": "🦋 🦋 🦋 🦋",
          "choices": [{ "id": "3", "label": "3" }, { "id": "4", "label": "4" }, { "id": "5", "label": "5" }],
      "description": "Guide a bright little snake around the garden and choose how far you want to go.",
          "hint": "Start at the left and count forward."
        },
        {
          "prompt": "Which number comes after 6?",
          "visual": "5  6  ❓",
          "choices": [{ "id": "5", "label": "5" }, { "id": "7", "label": "7" }, { "id": "8", "label": "8" }],
          "answer": "7",
          "hint": "Numbers grow by one."
        },
        {
          "prompt": "Which group has more apples?",
          "visual": "🍎 🍎   or   🍎 🍎 🍎",
          "choices": [{ "id": "left", "label": "Left group" }, { "id": "right", "label": "Right group" }, { "id": "same", "label": "They are equal" }],
          "answer": "right",
          "hint": "Compare the number of apples in each group."
        }
      ]
    },
    {
      "id": "color-patterns",
      "title": "Color Patterns",
      "ageBand": "5-10",
      "minAge": 5,
      "maxAge": 10,
      "category": "Patterns",
      "icon": "🎨",
      "accent": "coral",
      "description": "Spot the repeating colors and finish each cheerful pattern.",
      "skills": ["Pattern recognition", "Visual reasoning"],
      "durationMinutes": 6,
      "difficulty": "Growing",
      "interaction": "pattern",
      "rounds": [
        {
          "prompt": "What comes next?",
          "visual": "🔴 🔵 🔴 🔵 ❓",
          "choices": [{ "id": "red", "label": "Red" }, { "id": "blue", "label": "Blue" }, { "id": "green", "label": "Green" }],
          "answer": "red",
          "hint": "The colors take turns."
        },
        {
          "prompt": "Which shape completes the pattern?",
          "visual": "⭐ ⭐ 🌙 ⭐ ⭐ ❓",
          "choices": [{ "id": "star", "label": "Star" }, { "id": "moon", "label": "Moon" }, { "id": "sun", "label": "Sun" }],
          "answer": "moon",
          "hint": "Look for the small group that repeats."
        },
        {
          "prompt": "What comes next in this size pattern?",
          "visual": "●  ●●  ●  ●●  ❓",
          "choices": [{ "id": "one", "label": "One dot" }, { "id": "two", "label": "Two dots" }, { "id": "three", "label": "Three dots" }],
          "answer": "one",
          "hint": "The groups alternate between one and two dots."
        },
        {
          "prompt": "Finish the pattern.",
          "visual": "🟩 🟨 🟨 🟩 🟨 🟨 ❓",
          "choices": [{ "id": "green", "label": "Green" }, { "id": "yellow", "label": "Yellow" }, { "id": "purple", "label": "Purple" }],
          "answer": "green",
          "hint": "Each group has one green and two yellow squares."
        }
      ]
    },
    {
      "id": "word-detective",
      "title": "Word Detective",
      "ageBand": "5-10",
      "minAge": 5,
      "maxAge": 10,
      "category": "Words",
      "icon": "🔎",
      "accent": "mint",
      "description": "Follow clues, build vocabulary, and find the word that fits.",
